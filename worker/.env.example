# The worker's own environment: NOT the web app's. Give this file to the worker
# only (a systemd EnvironmentFile or a container --env-file). The dashboard never
# needs, and must never be given, the school database URLs or the deploy key.

# The control-plane Supabase project (the worker reads and writes jobs there).
SUPABASE_URL=https://<control-plane-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# JSON map: school slug -> that school's DIRECT Postgres connection string
# (Supabase: Project Settings, Database, Connection string, "Direct connection";
# migrations need a real session, not the pooler). Interim, until Infisical.
SCHOOL_DB_URLS={"greenfield":"postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"}

# Optional but recommended: the Supabase project CA certificate, so the worker
# verifies the database server instead of only encrypting the connection.
# SCHOOL_DB_CA_FILE=/etc/control-plane/supabase-ca.pem

# The VPS deploy script over SSH (see deploy/README.md). The known_hosts file
# must already contain the server's key; the worker never trusts a new one.
DEPLOY_SSH_HOST=203.0.113.10
DEPLOY_SSH_USER=root
DEPLOY_SSH_KEY_FILE=/etc/control-plane/deploy_ed25519
DEPLOY_SSH_KNOWN_HOSTS=/etc/control-plane/known_hosts

# Optional
# WORKER_ID=vps-1
# POLL_MS=3000
# STALE_MINUTES=45
# SCAN_EVERY_MINUTES=30
