# The worker's own environment: NOT the web app's. Give this file to the worker
# only (a systemd EnvironmentFile or a container --env-file). The dashboard never
# needs, and must never be given, the school database URLs or the deploy key.

# The control-plane Supabase project (the worker reads and writes jobs there).
SUPABASE_URL=https://<control-plane-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# JSON map: school slug -> that school's DIRECT Postgres connection string
# (Supabase: Project Settings, Database, Connection string, "Direct connection";
# migrations need a real session, not the pooler). Interim, until Infisical.
SCHOOL_DB_URLS={"greenfield":"postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"}

# Only needed to PROVISION a new school from the dashboard (docs/provisioning.md).
# JSON map: school slug -> the settings its container starts with. Every key is
# checked before anything is changed; SCHOOL_SLUG is set for you. Interim, until
# Infisical. The three Supabase values and the R2 bucket must belong to THIS school.
# SCHOOL_APP_ENVS={"greenfield":{"SUPABASE_URL":"https://<ref>.supabase.co","SUPABASE_ANON_KEY":"","SUPABASE_SERVICE_ROLE_KEY":"","R2_ENDPOINT":"https://<account-id>.r2.cloudflarestorage.com","R2_BUCKET":"greenfield-files","R2_ACCESS_KEY_ID":"","R2_SECRET_ACCESS_KEY":"","IMPERSONATION_SIGNING_SECRET":"<openssl rand -hex 32>"}}

# Optional but recommended: the Supabase project CA certificate, so the worker
# verifies the database server instead of only encrypting the connection.
# SCHOOL_DB_CA_FILE=/etc/control-plane/supabase-ca.pem

# The VPS deploy script over SSH (see deploy/README.md). The known_hosts file
# must already contain the server's key; the worker never trusts a new one.
DEPLOY_SSH_HOST=203.0.113.10
DEPLOY_SSH_USER=root
DEPLOY_SSH_KEY_FILE=/etc/control-plane/deploy_ed25519
DEPLOY_SSH_KNOWN_HOSTS=/etc/control-plane/known_hosts

# Backup taken before a school's migrations run (docs/worker.md, "Backups").
# REQUIRED: the worker will not start without them, because a worker that cannot
# back up must not be the one migrating school databases.
#
# The age PUBLIC key. Make a key pair just for school backups, with
# `age-keygen -o school-backups-key.txt`; put the "Public key: age1..." value
# here and keep the file (the private key) OFFLINE, never on this machine and
# never in this repository. Do not reuse the control-plane backup key.
BACKUP_AGE_RECIPIENT=age1...
# R2 (S3-compatible). Use a bucket and an API token of their own, scoped to
# that bucket with Object Read & Write (the worker deletes old backups).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=school-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: lets the dashboard's "Register a release" read a commit's migrations
# from GitHub. A fine-grained token with read-only access to the school app
# repository's contents, nothing else. Without it, register releases with
# `npm run register-release`.
# GITHUB_TOKEN=
# SCHOOL_APP_REPO=jaladedev/school_app

# Optional: the control plane's own Telegram bot (create it with @BotFather, send it
# a message, then read the chat id). Used for new transfer-claim notices and the
# 48-hour reminder. Without both, claim notices show as failed jobs and the claims
# still wait in the Billing queue.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# The dashboard's address, for the link in a notice.
# APP_URL=https://dashboard.example.com

# Optional
# BACKUP_PREFIX=schools          # objects are <prefix>/<slug>/<time>-<id>.dump.age
# BACKUP_KEEP=10                 # finished backups kept per school (at least 3)
# BACKUP_TIMEOUT_MINUTES=30      # pg_dump gives up after this long
# BACKUP_TMP_DIR=/var/tmp        # needs room for the dump and its encrypted copy
# WORKER_ID=vps-1
# POLL_MS=3000
# STALE_MINUTES=45
# SCAN_EVERY_MINUTES=30
# Suspend a school once its licence (grace included) ended this many days ago and it has
# no open invoice or waiting claim. A confirmed payment lifts it again. 0 turns it off.
# AUTO_SUSPEND_AFTER_DAYS=90
