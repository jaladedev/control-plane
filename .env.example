# The control plane's OWN Supabase project (never a school's).
SUPABASE_URL=https://your-control-plane-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bearer secret for the scheduled health run (.github/workflows/health.yml).
# At least 32 characters: openssl rand -hex 32. Leave unset to disable the route.
CRON_SECRET=

# Licence pushes: JSON map of school slug -> that school's service-role key.
# Interim, until a secrets manager exists. Treat this file/env as the most
# sensitive thing you own. Example: {"greenfield":"eyJ..."}
SCHOOL_SERVICE_KEYS=

# Read-only support links: JSON map of school slug -> that school's
# IMPERSONATION_SIGNING_SECRET (the value in the school's own env file, 32+
# characters). Interim, like SCHOOL_SERVICE_KEYS. Example: {"greenfield":"..."}
SCHOOL_SIGNING_SECRETS=

# Who invoice and receipt PDFs come from (optional). Lines are separated by "|":
# your address, then the bank details a school should pay into.
BILLING_ISSUER_NAME=
BILLING_ISSUER_LINES=

# Proofs of payment go in a bucket of their own (not a school's, not the backup bucket).
# The token needs Object Read & Write on that bucket only. All four or none.
PROOF_R2_ENDPOINT=
PROOF_R2_BUCKET=
PROOF_R2_ACCESS_KEY_ID=
PROOF_R2_SECRET_ACCESS_KEY=

# Card payments through your one Paystack account. The SECRET key (Settings > API Keys).
# In the Paystack dashboard set the webhook URL to https://<this app>/api/paystack/webhook
PAYSTACK_SECRET_KEY=
